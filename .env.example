# Βάση δεδομένων Postgres (Vercel → Storage → Neon)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Τυχαίο μυστικό ≥ 32 χαρακτήρες (κρυπτογράφηση των μυστικών 2FA): openssl rand -hex 32
ENCRYPTION_KEY=
# Vercel Blob (Vercel → Storage → Blob). Δημιουργείται αυτόματα ως BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=
# Δημόσιο URL του ιστοτόπου (sitemap / canonical / Open Graph / σύνδεσμοι στα email). Το επίσημο domain:
NEXT_PUBLIC_SITE_URL=https://osaden.gr
# Μυστικό για την αυτόματη (προγραμματισμένη) αποστολή ενημερωτικών από το Vercel Cron: openssl rand -hex 24
CRON_SECRET=
# Μόνο για την πρώτη εγκατάσταση (npm run db:setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Angel

# --- Email (επαναφορά κωδικού). Διάλεξε ΕΝΑΝ πάροχο: Brevo ή Resend ---
# Brevo (δωρεάν, δεν χρειάζεται δικό σου domain): API key από SMTP & API → API Keys
BREVO_API_KEY=
# Resend (χρειάζεται επαληθευμένο domain για αποστολή σε οποιονδήποτε): API key από API Keys
RESEND_API_KEY=
# Η διεύθυνση noreply από την οποία στέλνονται ΟΛΑ τα email (επαναφορά κωδικού, κωδικοί OTP, ειδοποιήσεις ασφαλείας, ενημερωτικό δελτίο).
# Π.χ. noreply@τοdomain.gr. Στο Brevo πρέπει να είναι επαληθευμένος αποστολέας, στο Resend διεύθυνση του επαληθευμένου domain.
MAIL_FROM_EMAIL=
# Το όνομα αποστολέα (προαιρετικό)
MAIL_FROM_NAME=Όσα δεν γράφει ο πίνακας

# --- Προαιρετικά: έλεγχος «δεν είμαι ρομπότ» στις εγγραφές (Cloudflare Turnstile, δωρεάν) ---
# Και τα δύο κλειδιά από dash.cloudflare.com → Turnstile → Add widget. Μετά την προσθήκη κάνε Redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Chat (chat.osaden.gr) ----------
# Ably (πραγματικός χρόνος): ably.com → Apps → API Keys → το κλειδί «Root» (μορφή xxxx.yyyy:zzzz). Χωρίς αυτό το chat δουλεύει με ανανέωση κάθε 3″.
ABLY_API_KEY=
# Κοινή σύνδεση σε osaden.gr και chat.osaden.gr
COOKIE_DOMAIN=.osaden.gr
# Πού βρίσκεται το chat (για τους συνδέσμους του κυρίως ιστοτόπου)
NEXT_PUBLIC_CHAT_URL=https://chat.osaden.gr
# Συνιστάται: Cloudflare TURN για κλήσεις (δωρεάν έως 1.000 GB/μήνα). dash.cloudflare.com → Realtime → TURN Server → Create.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Εναλλακτικά: δικός σας διακομιστής TURN για κλήσεις μέσα από αυστηρά δίκτυα (π.χ. σχολικό Wi-Fi). Π.χ. από metered.ca ή Cloudflare.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
