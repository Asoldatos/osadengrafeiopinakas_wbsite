# Βάση δεδομένων Postgres (Vercel → Storage → Neon)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Τυχαίο μυστικό ≥ 32 χαρακτήρες (κρυπτογράφηση των μυστικών 2FA): openssl rand -hex 32
ENCRYPTION_KEY=
# Vercel Blob (Vercel → Storage → Blob). Δημιουργείται αυτόματα ως BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=
# Δημόσιο URL του ιστοτόπου (sitemap / canonical / Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.vercel.app
# Μόνο για την πρώτη εγκατάσταση (npm run db:setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Διαχειριστής

# --- Email (επαναφορά κωδικού). Διάλεξε ΕΝΑΝ πάροχο: Brevo ή Resend ---
# Brevo (δωρεάν, δεν χρειάζεται δικό σου domain): API key από SMTP & API → API Keys
BREVO_API_KEY=
# Resend (χρειάζεται επαληθευμένο domain για αποστολή σε οποιονδήποτε): API key από API Keys
RESEND_API_KEY=
# Η διεύθυνση noreply από την οποία στέλνονται ΟΛΑ τα email (επαναφορά κωδικού, κωδικοί OTP, ειδοποιήσεις ασφαλείας, ενημερωτικό δελτίο).
# Π.χ. noreply@τοdomain.gr. Στο Brevo πρέπει να είναι επαληθευμένος αποστολέας, στο Resend διεύθυνση του επαληθευμένου domain.
MAIL_FROM_EMAIL=
# Το όνομα αποστολέα (προαιρετικό)
MAIL_FROM_NAME=Όσα δεν γράφει ο πίνακας

# --- Προαιρετικά: έλεγχος «δεν είμαι ρομπότ» στις εγγραφές (Cloudflare Turnstile, δωρεάν) ---
# Και τα δύο κλειδιά από dash.cloudflare.com → Turnstile → Add widget. Μετά την προσθήκη κάνε Redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
